alias aliases='pico ~/.oh-my-zsh/custom/aliases.zsh'
alias d='sudo docker'
alias h='sudo -E helm'
alias k='sudo k3s kubectl'
alias kga='sudo k3s kubectl get --all-namespaces'
alias k9s='sudo k9s --kubeconfig /etc/rancher/k3s/k3s.yaml'
alias updateallthethings='omz update && sudo apt update && sudo apt upgrade -y && sudo apt autoremove -y && updatek3s && updatehelm && updatek9s && atuin update'

updatek3s() {
  curl -sfL https://get.k3s.io | sudo sh -s - {{ k3s_install_args | default('') }}
}

updatehelm() {
  curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-4 | bash
}

updatek9s() {
  curl -fsSL https://github.com/derailed/k9s/releases/latest/download/k9s_Linux_amd64.tar.gz | sudo tar -xz -C /usr/local/bin k9s
}
